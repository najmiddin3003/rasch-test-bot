# @BotFather dan olingan token
BOT_TOKEN=

# MongoDB Atlas ulanish satri (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=rasch_bot

# Adminlarning Telegram ID lari, vergul bilan. ID ni bilish uchun botga /id yuboring
ADMIN_IDS=

# true bo'lsa admin /simulate <kod> <soni> bilan sinov qatnashchilarini qo'sha oladi
ENABLE_SIMULATE=false

# --- Ixtiyoriy ---
# Webhook rejimi (Render o'zi RENDER_EXTERNAL_URL beradi; Vercel'da kerak emas)
# WEBHOOK_URL=https://bot.example.com
# Telegram secret token (berilmasa BOT_TOKEN dan hosil qilinadi; Vercel'da qo'ymang)
# WEBHOOK_SECRET=
# PORT=10000
# Testlar uchun alohida MongoDB (berilmasa MONGODB_URI ishlatiladi)
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017
